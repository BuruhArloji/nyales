{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"nyales",
  "main":"src/server/index.ts",
  "compatibility_date":"2026-10-17",
  "triggers":{"crons":["10 * * * *"]},
  "observability":{"enabled":true,"head_sampling_rate":0.1},
  "compatibility_flags":["nodejs_compat"],
  "assets":{"directory":"./dist/client","not_found_handling":"single-page-application","run_worker_first":["/api/*"]},
  "vars":{"APP_ENV":"production","LOCAL_AUTH":"false","FIREBASE_PROJECT_ID":""},
  "r2_buckets":[{"binding":"IMPORT_FILES","bucket_name":"nyales-import-sources"}],
  "d1_databases":[{"binding":"DB","database_name":"nyales","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"migrations"}]
}
