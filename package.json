    "pilot:demo": "tsx scripts/pilot-demo.ts",
    "pilot:local:prepare": "tsx scripts/pilot-local-prepare.ts",
    "pilot:local": "node scripts/pilot-local.cjs",
    "pilot:operations": "tsx scripts/pilot-operations.ts",
    "pilot:restore": "node scripts/pilot-local-restore.cjs",
    "test:pilot": "playwright test --config playwright.pilot.config.cjs",
    "training:check": "tsx scripts/training-check.ts",
    "test:boundaries": "playwright test --config playwright.boundaries.config.cjs",
