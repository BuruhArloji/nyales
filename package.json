    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "^1.13.0",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
