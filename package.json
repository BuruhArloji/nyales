    "visit:operational:contract": "tsx scripts/generate-visit-operational-contract.ts",
    "test:visit-operational": "playwright test --config playwright.visit-operational.config.cjs",
    "test:recovery": "playwright test --config playwright.recovery-objects.config.cjs",
    "pilot:release-gate": "tsx scripts/pilot-release-gate.ts",
    "staging:smoke": "node scripts/staging-smoke.mjs",
