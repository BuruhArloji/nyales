{
  "openapi": "3.1.0",
  "info": {
    "title": "NYALES bounded customer selector",
    "version": "1.0.0",
    "description": "Scope-checked canonical customer options only. Prefix name/ERP search, selected-ID hydration, keyset continuation. No invoice, segmentation or exact COUNT query."
  },
  "paths": {
    "/api/customer-options": {
      "get": {
        "operationId": "read_customer_options",
        "security": [
          {
            "BearerAuth": [],
            "DeviceSession": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "default": "",
              "type": "string",
              "maxLength": 100
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          {
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 1400
            }
          },
          {
            "in": "query",
            "name": "id",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "in": "query",
            "name": "record_status",
            "required": false,
            "schema": {
              "default": "active",
              "type": "string",
              "enum": [
                "active",
                "all"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "At most 50 options, default 20; next cursor bound to query, business date and current scope. A missing/inaccessible selected ID yields an empty list.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "maxItems": 50,
                      "items": {
                        "$ref": "#/components/schemas/option"
                      }
                    },
                    "meta": {
                      "type": "object",
                      "required": [
                        "has_more",
                        "next",
                        "limit",
                        "search_mode"
                      ],
                      "properties": {
                        "has_more": {
                          "type": "boolean"
                        },
                        "next": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "limit": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 50
                        },
                        "search_mode": {
                          "const": "name_or_erp_prefix"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Scope denied"
          },
          "422": {
            "description": "Invalid query or cursor/filter/scope mismatch"
          },
          "503": {
            "description": "Customer options unavailable"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "option": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "external_code",
          "area_id",
          "record_status",
          "visit_window"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "external_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "area_id": {
            "type": "string"
          },
          "record_status": {
            "enum": [
              "active",
              "inactive"
            ]
          },
          "visit_window": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "DeviceSession": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Device-Session"
      }
    }
  },
  "x-migration": "0052_customer_option_indexes.sql",
  "x-read-boundary": "Authorization before pagination/hydration; no cursor confers access. API rejects wildcard expansion and never offers merged aliases as new selections."
}
