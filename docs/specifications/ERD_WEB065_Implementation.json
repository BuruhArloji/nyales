      "triggers": [
        {
          "name": "area_admin_insert_guard",
          "sql": "CREATE TRIGGER area_admin_insert_guard BEFORE INSERT ON area_admin_membership BEGIN\n SELECT CASE WHEN NOT EXISTS(SELECT 1 FROM admin_boundary b WHERE b.organization_id=NEW.organization_id AND b.id=NEW.boundary_id AND b.admin_unit_id=NEW.admin_unit_id) OR EXISTS(SELECT 1 FROM area_admin_membership a WHERE a.organization_id=NEW.organization_id AND a.admin_unit_id=NEW.admin_unit_id AND a.effective_from_date<COALESCE(NEW.effective_to_date,'9999-12-31') AND NEW.effective_from_date<COALESCE(a.effective_to_date,'9999-12-31')) THEN RAISE(ABORT,'ADMIN_AREA_OVERLAP_OR_BOUNDARY') END;\nEND"
        },
        {
          "name": "area_admin_update_guard",
          "sql": "CREATE TRIGGER area_admin_update_guard BEFORE UPDATE ON area_admin_membership BEGIN\n SELECT CASE WHEN NEW.organization_id IS NOT OLD.organization_id OR NEW.admin_unit_id IS NOT OLD.admin_unit_id OR NEW.area_id IS NOT OLD.area_id OR NEW.boundary_id IS NOT OLD.boundary_id OR NEW.effective_from_date IS NOT OLD.effective_from_date OR (OLD.effective_to_date IS NOT NULL AND (NEW.effective_to_date IS NULL OR NEW.effective_to_date>OLD.effective_to_date)) OR EXISTS(SELECT 1 FROM area_admin_membership a WHERE a.id<>OLD.id AND a.organization_id=NEW.organization_id AND a.admin_unit_id=NEW.admin_unit_id AND a.effective_from_date<COALESCE(NEW.effective_to_date,'9999-12-31') AND NEW.effective_from_date<COALESCE(a.effective_to_date,'9999-12-31')) THEN RAISE(ABORT,'ADMIN_AREA_HISTORY') END;\nEND"
        },
        {
          "name": "area_admin_no_delete",
          "sql": "CREATE TRIGGER area_admin_no_delete BEFORE DELETE ON area_admin_membership BEGIN SELECT RAISE(ABORT,'ADMIN_AREA_HISTORY_IMMUTABLE'); END"
        },
        {
          "name": "area_admin_reason_immutable",
          "sql": "CREATE TRIGGER area_admin_reason_immutable BEFORE UPDATE ON area_admin_membership WHEN NEW.id IS NOT OLD.id OR NEW.reason IS NOT OLD.reason BEGIN SELECT RAISE(ABORT,'ADMIN_AREA_HISTORY_IMMUTABLE'); END"
        },
        {
          "name": "area_admin_area_active",
          "sql": "CREATE TRIGGER area_admin_area_active BEFORE INSERT ON area_admin_membership WHEN NOT EXISTS(SELECT 1 FROM area WHERE organization_id=NEW.organization_id AND id=NEW.area_id AND status='active') BEGIN SELECT RAISE(ABORT,'ADMIN_AREA_INACTIVE'); END"
        },
        {
          "name": "geo_epoch_area_admin_membership_insert",
          "sql": "CREATE TRIGGER geo_epoch_area_admin_membership_insert AFTER INSERT ON area_admin_membership BEGIN INSERT INTO geo_distribution_epoch(organization_id,epoch) VALUES(NEW.organization_id,1) ON CONFLICT(organization_id) DO UPDATE SET epoch=epoch+1; END"
        },
        {
          "name": "geo_epoch_area_admin_membership_update",
          "sql": "CREATE TRIGGER geo_epoch_area_admin_membership_update AFTER UPDATE ON area_admin_membership BEGIN INSERT INTO geo_distribution_epoch(organization_id,epoch) VALUES(NEW.organization_id,1) ON CONFLICT(organization_id) DO UPDATE SET epoch=epoch+1; END"
        },
        {
