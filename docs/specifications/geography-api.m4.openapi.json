  "components": {
    "schemas": {
      "preview": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "dataset_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "code_namespace": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "admin_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "additionalProperties": false,
        "dependentRequired": {
          "admin_code": [
            "code_namespace"
          ],
          "code_namespace": [
            "admin_code"
          ]
        }
      },
      "review": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "dataset_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "preview_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "customer_version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "mapping_revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "decision": {
            "type": "string",
            "enum": [
              "confirm_candidate",
              "manual",
              "needs_review",
              "outside_coverage"
            ]
          },
          "boundary_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 8,
            "maxLength": 1000
          },
          "code_namespace": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "admin_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "dataset_id",
          "preview_hash",
          "customer_version",
          "mapping_revision",
          "decision",
          "boundary_id",
          "reason"
        ],
        "additionalProperties": false,
        "dependentRequired": {
          "admin_code": [
            "code_namespace"
          ],
          "code_namespace": [
            "admin_code"
          ]
        }
      },
      "error": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          }
        }
      },
      "envelope": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {}
        },
        "additionalProperties": true
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "DeviceSession": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Device-Session"
      }
    }
  }
}
