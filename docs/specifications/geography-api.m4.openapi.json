{
  "openapi": "3.1.0",
  "info": {
    "title": "NYALES WEB-064 implemented geography API",
    "version": "0.1.0",
    "description": "Local implementation, current operational mapping only. D1 metadata and immutable review history; private R2 full geometry. Regional financial/coverage analytics are WEB-066. /api/customers additionally supports geo_boundary_id OR geo_bucket (unmapped, confirmed, stale, needs_review, outside_coverage), geo_dataset_id (active only), alongside existing scoped area/rep/channel filters. No routing or territory commit."
  },
  "paths": {
    "/api/geo/map": {
      "get": {
        "summary": "Scoped operational customer pins, last received sales positions, boundary metadata and current confirmed/unmapped totals. Draft preview is Management/NSM only.",
        "operationId": "geo_get__api_geo_map",
        "parameters": [
          {
            "in": "query",
            "name": "area_id",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Current scope applies."
          },
          {
            "in": "query",
            "name": "rep_id",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Current scope applies."
          },
          {
            "in": "query",
            "name": "channel",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Current scope applies."
          },
          {
            "in": "query",
            "name": "customer_status",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Current scope applies."
          },
          {
            "in": "query",
            "name": "period",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "YYYY-MM navigation context only; matching and counts use current effective date."
          },
          {
            "in": "query",
            "name": "dataset_id",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Current scope applies."
          }
        ],
        "x-access-policy": "Tenant and customer/area/team/channel scope; non-active releases require Management/NSM.",
        "responses": {
          "200": {
            "description": "Resource envelope. See endpoint summary; not a fully typed response SDK.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/envelope"
                }
              }
            }
          },
          "400": {
            "description": "Idempotency header invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication or device session missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
