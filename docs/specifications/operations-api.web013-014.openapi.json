{
  "openapi": "3.1.0",
  "info": {
    "title": "NYALES implemented import and duplicate review API",
    "version": "0.14.0",
    "description": "Management/NSM only. CSV UTF-8, comma/semicolon/tab, maximum 512 KiB and 200 records. Sources kept under retention hold pending organization policy; no automatic deletion. Commit requires If-Match for validation batch. Merge requires source If-Match plus reviewed surviving_version and explicit same-location confirmation. Stale snapshots roll back the complete valid-row transaction. Merge never rewrites invoice/assignment facts or combines contact consent. Reads through old IDs resolve to the permitted canonical outlet."
  },
  "security": [
    {
      "FirebaseBearer": [],
      "DeviceSession": []
    }
  ],
  "paths": {
    "/api/import-files": {
      "post": {
        "summary": "Retain original CSV bytes in R2, checksum-deduplicated within organization",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": [
                  "file"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success / idempotent replay"
          },
          "201": {
            "description": "Source or validation created"
          },
          "400": {
            "description": "Idempotency header required"
          },
          "401": {
            "description": "Identity or device session invalid"
          },
          "403": {
            "description": "Management/NSM only"
          },
          "404": {
            "description": "Resource absent or outside organization"
          },
          "409": {
            "description": "Snapshot, source checksum, identity or business conflict; no partial transaction applied"
          },
          "412": {
            "description": "Version stale"
          },
          "413": {
            "description": "Request over upload bound"
          },
          "422": {
            "description": "CSV, mapping or review invalid"
          },
          "428": {
            "description": "If-Match required for commit/merge"
          },
          "503": {
            "description": "D1 or R2 unavailable"
          }
        }
      }
    },
