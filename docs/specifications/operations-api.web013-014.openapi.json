        }
      },
      "post": {
        "summary": "Dry-run or atomic commit of all valid staged rows",
        "responses": {
          "200": {
            "description": "Success / idempotent replay"
          },
          "201": {
            "description": "Source or validation created"
          },
          "400": {
            "description": "Idempotency header required"
          },
          "401": {
            "description": "Identity or device session invalid"
          },
          "403": {
            "description": "Management/NSM only"
          },
          "404": {
            "description": "Resource absent or outside organization"
          },
          "409": {
            "description": "Snapshot, source checksum, identity or business conflict; no partial transaction applied"
          },
          "412": {
            "description": "Version stale"
          },
          "413": {
            "description": "Request over upload bound"
          },
          "422": {
            "description": "CSV, mapping or review invalid"
          },
          "428": {
            "description": "If-Match required for commit/merge"
          },
          "503": {
            "description": "D1 or R2 unavailable"
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          },
          {
            "in": "header",
            "name": "If-Match",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Required when mode=commit; use the current validation batch version quoted as an ETag."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "customer",
                      "product"
                    ]
                  },
                  "attachment_id": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "mapping": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "mode": {
                    "enum": [
                      "dry_run",
                      "commit"
                    ]
                  },
                  "validation_batch_id": {
                    "type": "string"
                  },
                  "allow_partial": {
                    "type": "boolean",
                    "default": false
                  }
                },
                "required": [
                  "kind",
                  "attachment_id",
                  "mapping",
                  "mode"
                ],
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "mode": {
                          "const": "commit"
                        }
                      },
                      "required": [
                        "mode"
                      ]
                    },
                    "then": {
                      "required": [
                        "validation_batch_id"
                      ]
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
