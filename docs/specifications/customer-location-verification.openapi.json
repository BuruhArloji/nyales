                  },
                  "max_accuracy_m": {
                    "type": "integer",
                    "minimum": 5,
                    "maximum": 500
                  },
                  "max_age_seconds": {
                    "type": "integer",
                    "minimum": 30,
                    "maximum": 600
                  },
                  "allow_unverified_visits": {
                    "type": "boolean"
                  },
                  "allow_outside_exception": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
