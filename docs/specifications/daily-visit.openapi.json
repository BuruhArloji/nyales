{
  "openapi": "3.1.0",
  "info": {
    "title": "NYALES daily visit generator",
    "version": "1.0.0",
    "description": "Same-day ORS generation from assigned customers, explicit policy, immutable preview and explicit atomic agenda application. Fixed hosts and header-only provider key. No monthly planning guarantee. Runtime Zod and domain tests authoritative. Verified Google owner may submit custom_work_hours=true for a future same-day interval of at most 12 hours. Setup returns custom_work_hours_allowed. Calendar settings and customer opening windows stay unchanged; only owner may apply such previews."
  },
  "security": [
    {
      "BearerAuth": [],
      "DeviceSession": []
    }
  ],
  "paths": {
    "/api/visit-generator/daily/setup": {
      "get": {
        "operationId": "daily_get__api_visit-generator_daily_setup",
        "summary": "GET /api/visit-generator/daily/setup",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Scoped response or applied route"
          },
          "201": {
            "description": "ORS preview created without agenda changes"
          },
          "400": {
            "description": "Missing idempotency key"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Read-only or scope denied"
          },
          "404": {
            "description": "Missing or outside scope"
          },
          "409": {
            "description": "Stale source, active visit or agenda conflict"
          },
          "412": {
            "description": "Stale policy version"
          },
          "422": {
            "description": "Invalid policy, calendar, customer or time window"
          },
          "503": {
            "description": "Provider or storage unavailable; agenda unchanged"
          }
        }
      }
    },
