  "components": {
    "securitySchemes": {
      "FirebaseBearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "DeviceSession": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Device-Session"
      }
    },
    "schemas": {
      "OutletWrite": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "address": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "area_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "external_code": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          },
          "latitude_e7": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -900000000,
                "maximum": 900000000
              },
              {
                "type": "null"
              }
            ]
          },
          "longitude_e7": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -1800000000,
                "maximum": 1800000000
              },
              {
                "type": "null"
              }
            ]
          },
          "coordinate_status": {
            "type": "string",
            "enum": [
              "missing",
              "unverified",
              "verified"
            ]
          },
          "location_note": {
            "type": "string",
            "maxLength": 500
          },
          "record_status": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ]
          },
          "outlet_type": {
            "type": "string",
            "maxLength": 80
          },
          "service_frequency_days": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 365
              },
              {
                "type": "null"
              }
            ]
          },
          "visit_window": {
            "type": "string",
            "maxLength": 160
          }
        },
        "required": [
          "name",
          "address",
          "area_id"
        ],
        "description": "One outlet has one coordinate pair. Omit both or use null/null for missing location; zero is valid. verified requires a location_note and is manual verification, not device evidence. Existing assignments/invoices/targets block area changes until WEB-015. Optional non-permission fields use full-write defaults when omitted."
      },
      "ContactWrite": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "customer_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "phone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Indonesian 0/62 prefixes or international +/00 form; spaces, hyphens and parentheses accepted. Server stores normalized E164 (8-15 digits)."
          },
          "contact_role": {
            "type": "string",
            "maxLength": 100
          },
          "preferred_channel": {
            "type": "string",
            "enum": [
              "field",
              "telesales"
            ]
          },
          "permission_status": {
            "type": "string",
            "enum": [
              "unknown",
              "allowed",
              "denied",
              "dnc"
            ]
          },
          "permission_note": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "customer_id",
          "name",
          "phone",
          "preferred_channel"
        ],
        "description": "Permission is declared manually and never enables calling by itself. Non-unknown permission requires a note. On PUT, omitted permission fields preserve existing permission. Any phone change resets permission to unknown even if permission fields are sent; update consent in a subsequent request. customer_id is immutable on update. Shared numbers do not merge outlets."
      },
      "Problem": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "MasterRecord": {
        "type": "object",
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": true
      },
      "ContactRead": {
        "type": "object",
        "required": [
          "id",
          "name",
          "customer_id",
          "phone_display",
          "permission_status",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "customer_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "phone_display": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "description": "Management/NSM only. Other roles receive masked phone_display; permission_note also omitted."
          },
          "permission_status": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          }
        },
        "additionalProperties": true
      },
      "TimelineEvent": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "occurred_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "kind": {
            "type": "string"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "invoice_date": {
            "type": "string",
            "format": "date"
          },
          "label": {
            "type": "string"
          },
          "amount": {
            "type": "integer",
            "description": "Rupiah integer, following the current invoice storage convention."
          }
        }
      }
    }
  }
}
