{
  "openapi": "3.1.0",
  "info": {
    "title": "NYALES sales tracking API",
    "version": "0.1.0",
    "description": "User initiated session, scoped tracking and bounded batch transport. Location estimates are not proof of a visit."
  },
  "paths": {
    "/api/sales-tracking/session": {
      "get": {
        "operationId": "trackingSession",
        "summary": "Current user active tracking session",
        "security": [
          {
            "BearerAuth": [],
            "DeviceSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "403": {
            "description": "Access denied"
          },
          "422": {
            "description": "Invalid input"
          },
          "503": {
            "description": "Tracking temporarily unavailable"
          }
        }
      },
      "post": {
        "operationId": "trackingStart",
        "summary": "Start a tracking session with explicit consent",
        "security": [
          {
            "BearerAuth": [],
            "DeviceSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "403": {
            "description": "Access denied"
          },
          "422": {
            "description": "Invalid input"
          },
          "503": {
            "description": "Tracking temporarily unavailable"
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "consent"
                ],
                "properties": {
                  "consent": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/sales-tracking/session/{id}/stop": {
      "post": {
        "operationId": "trackingStop",
        "summary": "Stop own tracking session",
        "security": [
          {
            "BearerAuth": [],
            "DeviceSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "403": {
            "description": "Access denied"
          },
          "422": {
            "description": "Invalid input"
          },
          "503": {
            "description": "Tracking temporarily unavailable"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "stopped_at"
                ],
                "properties": {
                  "stopped_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/sales-tracking/session/{id}/batches": {
      "post": {
        "operationId": "trackingBatch",
        "summary": "Upload an idempotent immutable GPS batch",
        "security": [
          {
            "BearerAuth": [],
            "DeviceSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "403": {
            "description": "Access denied"
          },
          "422": {
            "description": "Invalid input"
          },
          "503": {
            "description": "Tracking temporarily unavailable"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "batch_id",
                  "points"
                ],
                "properties": {
                  "batch_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "points": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "latitude",
                        "longitude",
                        "accuracy_m",
                        "captured_at"
                      ],
                      "properties": {
                        "latitude": {
                          "type": "number",
                          "minimum": -90,
                          "maximum": 90
                        },
                        "longitude": {
                          "type": "number",
                          "minimum": -180,
                          "maximum": 180
                        },
                        "accuracy_m": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 100
                        },
                        "captured_at": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/sales-tracking/latest": {
      "get": {
        "operationId": "trackingLatest",
        "summary": "Latest positions in authorized scope",
        "security": [
          {
            "BearerAuth": [],
            "DeviceSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "403": {
            "description": "Access denied"
          },
          "422": {
            "description": "Invalid input"
          },
          "503": {
            "description": "Tracking temporarily unavailable"
          }
        },
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ]
      }
    },
    "/api/sales-tracking/history": {
      "get": {
        "operationId": "trackingHistory",
        "summary": "Paginated day history in authorized scope",
        "security": [
          {
            "BearerAuth": [],
            "DeviceSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "403": {
            "description": "Access denied"
          },
          "422": {
            "description": "Invalid input"
          },
          "503": {
            "description": "Tracking temporarily unavailable"
          }
        },
        "parameters": [
          {
            "name": "user_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "DeviceSession": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Device-Session"
      }
    }
  }
}
