{
  "openapi": "3.1.0",
  "info": {
    "title": "NYALES WEB-056 actual local API",
    "version": "0.1.0",
    "description": "Runtime /api slice, not deployment proof. All data organization-scoped. Cloud provider usage is manually recorded, fresh <=6h and current UTC window only. CPU and missing quota remain unknown. No provider provisioning or business deletion."
  },
  "paths": {
    "/api/observability/summary": {
      "get": {
        "operationId": "getOperationsSummary",
        "summary": "Management/NSM: organization metrics, queue gauges, current manual quota snapshots and profile",
        "security": [
          {
            "bearerAuth": [],
            "deviceSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Authentication/session required"
          },
          "403": {
            "description": "Role or provider account owner denied"
          },
          "422": {
            "description": "Invalid input or stale provider measurement"
          }
        }
      }
    },
    "/api/observability/policy": {
      "post": {
        "operationId": "saveCapacityProfile",
        "summary": "Management/NSM: versioned pilot profile and active Management/NSM alert owner",
        "security": [
          {
            "bearerAuth": [],
            "deviceSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Authentication/session required"
          },
          "403": {
            "description": "Role or provider account owner denied"
          },
          "422": {
            "description": "Invalid input or stale provider measurement"
          },
          "412": {
            "description": "If-Match version conflict"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "owner_user_id",
                  "pilot_reps",
                  "pilot_customers",
                  "pilot_invoices_month",
                  "concurrent_users",
                  "api_requests_day",
                  "reason"
                ],
                "properties": {
                  "owner_user_id": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "pilot_reps": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                  },
                  "pilot_customers": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000000
                  },
                  "pilot_invoices_month": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000000
                  },
                  "concurrent_users": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                  },
                  "api_requests_day": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000000
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 500
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          },
          {
            "in": "header",
            "name": "If-Match",
            "required": false,
            "description": "Required for updates, quoted current version",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/observability/usage": {
      "post": {
        "operationId": "recordProviderUsage",
        "summary": "Deployment-owning organization Management/NSM: immutable manual provider dashboard snapshot; unique alerts at 70/85/95",
        "security": [
          {
            "bearerAuth": [],
            "deviceSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Authentication/session required"
          },
          "403": {
            "description": "Role or provider account owner denied"
          },
          "422": {
            "description": "Invalid input or stale provider measurement"
          },
          "201": {
            "description": "Snapshot recorded; crossed threshold notification rows deduplicated atomically"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "metric",
                  "value",
                  "sampled_at",
                  "reason"
                ],
                "properties": {
                  "metric": {
                    "type": "string",
                    "enum": [
                      "workers_requests",
                      "d1_reads",
                      "d1_writes",
                      "d1_database_bytes",
                      "d1_account_bytes",
                      "workers_cpu_ms",
                      "r2_storage",
                      "r2_a",
                      "r2_b"
                    ]
                  },
                  "value": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "sampled_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "No older than six hours and at most 60 seconds in future"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 500
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ]
      }
    },
    "/api/observability/events": {
      "post": {
        "operationId": "recordClientMapEvent",
        "summary": "Any authenticated scoped role: client-declared view count only",
        "security": [
          {
            "bearerAuth": [],
            "deviceSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Authentication/session required"
          },
          "403": {
            "description": "Role or provider account owner denied"
          },
          "422": {
            "description": "Invalid input or stale provider measurement"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "event"
                ],
                "properties": {
                  "event": {
                    "type": "string",
                    "enum": [
                      "map_2d",
                      "map_3d",
                      "street_view_open"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Firebase JWT (local demo separately gated)"
      },
      "deviceSession": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Device-Session"
      }
    }
  }
}
